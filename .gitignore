# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# labs-demo — a separate standalone project (own package.json, own Vercel deploy).
# It carries its own node_modules; never let it into this repo.
/labs-demo/

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (local tooling/session)
# .claude/ is local config, EXCEPT the agent definitions — those are project
# infrastructure (the 12-agent roster) and must be versioned. Note: exclude the
# CONTENTS (.claude/*), not the dir itself, or the negation below can't re-include.
.claude/*
!.claude/agents/

# Playwright
/test-results/
/playwright-report/
/e2e/.last-run.json
